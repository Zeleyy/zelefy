{
    "plugins": ["prettier-plugin-sql", "prettier-plugin-toml"],
    "tabWidth": 4,
    "useTabs": false,
    "printWidth": 100,
    "overrides": [
        {
            "files": "*.sqlite",
            "options": {
                "language": "sqlite"
            }
        },
        {
            "files": "*.sql",
            "options": {
                "language": "postgresql"
            }
        },
        {
            "files": "Cargo.toml",
            "options": {
                "parser": "toml"
            }
        }
    ]
}
