{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Zelefy Desktop",
    "version": "../package.json",
    "identifier": "com.zelefy.desktop",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Zelefy",
                "width": 900,
                "height": 600,
                "minWidth": 700,
                "minHeight": 450,
                "center": true,
                "decorations": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "createUpdaterArtifacts": true,
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyOEY0MDhGQUNGNDlEMTMKUldRVG5mU3NqMENQRW9LY3pXSmp2WGRNcFFId3k4b3Qwdmc5dG01aUlNamR3UFUrdERDbWFFSDgK",
            "endpoints": ["https://github.com/Zeleyy/zelefy/releases/latest/download/latest.json"]
        }
    }
}
