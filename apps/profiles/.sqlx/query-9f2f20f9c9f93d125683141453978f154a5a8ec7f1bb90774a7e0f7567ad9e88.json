  "query": "\n            DELETE FROM profile_social_links AS psl\n            USING (\n                SELECT * FROM UNNEST($1::uuid[], $2::text[])\n                AS t(user_id, platform)\n            ) AS del\n            WHERE psl.user_id = del.user_id\n              AND psl.platform = del.platform\n            RETURNING psl.user_id, psl.platform, psl.url\n        ",
