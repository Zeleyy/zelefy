  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                t.track_id\n                , t.user_id\n                , t.title\n                , t.permalink\n                , t.audio_url\n                , t.cover_url\n                , t.waveform_url\n                , t.duration_seconds\n                , t.genre\n                , t.description\n                , t.bpm\n                , t.key_signature\n                , t.is_private\n                , t.status AS \"status: TrackStatus\"\n                , t.processing_error\n                , t.created_at\n                , t.updated_at\n                , ts.plays_count\n                , ts.likes_count\n                , ts.reposts_count\n                , ts.comments_count\n            FROM tracks t\n            JOIN track_stats ts ON ts.track_id = t.track_id\n            WHERE t.permalink = $1\n        ",
